{
  "info": {
    "name": "Jurnal Kelas API",
    "description": "Token-authenticated JSON API for the Jurnal Kelas app.\n\nHOW TO USE:\n1. Run an 'Auth > Login' request once. A test script saves the returned token into the {{token}} collection variable automatically.\n2. Every other request inherits Bearer {{token}} — just send them.\n3. Path ids use variables ({{kelas_id}}, {{jurnal_id}}, {{user_id}}, ...) you can change under the collection Variables tab.\n\nBase URL defaults to http://localhost:8888/api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login as admin if no token is set yet, so no request ever 401s.",
          "// To browse as another role, run an Auth > Login request explicitly.",
          "if (!pm.collectionVariables.get('token')) {",
          "    pm.sendRequest({",
          "        url: pm.variables.replaceIn('{{base_url}}/login'),",
          "        method: 'POST',",
          "        header: { 'Accept': 'application/json' },",
          "        body: { mode: 'urlencoded', urlencoded: [",
          "            { key: 'user', value: 'admin@jurnalkelas.app' },",
          "            { key: 'password', value: 'password' },",
          "            { key: 'role', value: 'admin' }",
          "        ] }",
          "    }, function (err, res) {",
          "        if (!err && res.code === 200) { pm.collectionVariables.set('token', res.json().token); }",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8888/api" },
    { "key": "token", "value": "" },
    { "key": "kelas_id", "value": "1" },
    { "key": "mata_pelajaran_id", "value": "1" },
    { "key": "jadwal_id", "value": "1" },
    { "key": "jurnal_id", "value": "1" },
    { "key": "user_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "    console.log('Token saved to {{token}}');",
                  "} else {",
                  "    console.log('Login failed:', pm.response.code, pm.response.text());",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "user", "value": "admin@jurnalkelas.app" },
                { "key": "password", "value": "password" },
                { "key": "role", "value": "admin" }
              ]
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Login (guru)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "user", "value": "budi.santoso@jurnalkelas.app" },
                { "key": "password", "value": "password" },
                { "key": "role", "value": "guru" }
              ]
            },
            "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
          }
        },
        {
          "name": "Login (siswa)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "user", "value": "siswa20261001@jurnalkelas.app", "description": "NIS/NIP or email" },
                { "key": "password", "value": "password" },
