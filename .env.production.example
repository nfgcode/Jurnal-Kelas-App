# ── Production Environment Configuration Template ────────────────────────────
# Application: Jurnal Kelas App (SMK Negeri / Sekolah)
# PETUNJUK: Salin berkas ini ke .env di server produksi.
# Ganti seluruh placeholder <...> dengan kredensial rahasia yang sah.
# JANGAN commit berkas .env produksi ke dalam Git!

APP_NAME="Jurnal Kelas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jurnalkelas.sekolah.sch.id
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logging Configuration ────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ── Production Database (MySQL 8.0) ──────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jurnal_kelas
DB_USERNAME=jurnal_app_user
DB_PASSWORD=<SECURE_DATABASE_PASSWORD>

# ── Session, Cache & Queue (Redis Isolated) ──────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=<SECURE_REDIS_PASSWORD>
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Storage & Filesystem ─────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail Configuration ───────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<SMTP_USER>
MAIL_PASSWORD=<SMTP_PASS>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@jurnalkelas.sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Security & Headers ───────────────────────────────────────────────────────
# Jika berada di balik Reverse Proxy (Nginx/Cloudflare), daftarkan IP proxy di AppServiceProvider
TRUSTED_PROXIES="*"
